<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AI_Presentation_Coach.CreatePresentationPage"
             Title="Create Presentation">

    <ScrollView>

        <VerticalStackLayout
            Spacing="10"
            Padding="20">

            <!-- Page Heading -->
            <Label
                Text="Create Your Presentation"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,10,0,20" />

            <!-- Presentation Title -->
            <Label
                Text="Presentation Title"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter presentation title" />

            <!-- Presentation Topic -->
            <Label
                Text="Presentation Topic"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter presentation topic" />

            <!-- Audience -->
            <Label
                Text="Audience"
                FontAttributes="Bold" />

            <Picker
                Title="Select Audience">

                <Picker.Items>
                    <x:String>Students</x:String>
                    <x:String>Professionals</x:String>
                    <x:String>General Public</x:String>
                    <x:String>Lecturers</x:String>
                </Picker.Items>

            </Picker>

            <!-- Presentation Type -->
            <Label
                Text="Presentation Type"
                FontAttributes="Bold" />

            <Picker
                Title="Select Presentation Type">

                <Picker.Items>
                    <x:String>School / Academic</x:String>
                    <x:String>Business Pitch</x:String>
                    <x:String>Project Presentation</x:String>
                    <x:String>Informative</x:String>
                    <x:String>Persuasive</x:String>
                </Picker.Items>

            </Picker>

            <!-- Create Button -->
            <Button
                Text="Create Presentation"
                Margin="0,20,0,0" 
                Clicked="OnCreatePresentationClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>