<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AI_Presentation_Coach.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition />
                    <RowDefinition />

                </Grid.RowDefinitions>

                <Button
                    Text="Create Presentation"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                />

                <Button 
                    Text="My Presentation "
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    />

                <Button 
                    Text="Practice"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    
                    />

                <Button
                    Text="AI Coach"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    />

            </Grid>
                
                

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
