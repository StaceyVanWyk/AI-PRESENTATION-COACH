<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AI_Presentation_Coach.PresentationOutlinePage"
             Title="Presentation Outline">

    <ScrollView>

        <VerticalStackLayout
            Spacing="15"
            Padding="20">

            <!-- Page Heading -->
            <Label
                Text="Your Presentation Outline"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Presentation Information -->

            <Label
                x:Name="PresentationTitleLabel"
                Text=""
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="PresentationTopicLabel"
                Text=""
                FontSize="16" />

            <Label
                x:Name="AudienceLabel"
                Text=""
                FontSize="14" />

            <Label
                x:Name="PresentationTypeLabel"
                Text=""
                FontSize="14" />

            <!-- Description -->

            <Label
                Text="AI-generated outline based on your presentation details."
                FontSize="14"
                Margin="0,5,0,5" />

            <!-- Introduction -->

            <Frame
                Padding="15"
                CornerRadius="12">

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="1. Introduction"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="IntroductionLabel"
                        Text=""
                        FontSize="14" />

                </VerticalStackLayout>

            </Frame>

            <!-- Problem -->

            <Frame
                Padding="15"
                CornerRadius="12">

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="2. The Problem"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="ProblemLabel"
                        Text=""
                        FontSize="14" />

                </VerticalStackLayout>

            </Frame>

            <!-- Solution -->

            <Frame
                Padding="15"
                CornerRadius="12">

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="3. The Solution"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="SolutionLabel"
                        Text=""
                        FontSize="14" />

                </VerticalStackLayout>

            </Frame>

            <!-- Conclusion -->

            <Frame
                Padding="15"
                CornerRadius="12">

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="4. Conclusion"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="ConclusionLabel"
                        Text=""
                        FontSize="14" />

                </VerticalStackLayout>

            </Frame>

            <!-- Actions -->

            <Button
                Text="Edit Outline" />

            <Button
                Text="Generate Slides" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>