<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AI_Presentation_Coach.LoginPage"
    Title="Login"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F7FB">

    <ScrollView>

        <VerticalStackLayout
            Padding="28,45,28,30"
            Spacing="0">

            <!-- Logo / Brand -->
            <Border
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                BackgroundColor="#6C3BDE"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Margin="0,10,0,20">

                <Label
                    Text="AI"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <!-- Heading -->
            <Label
                Text="AI Presentation Coach"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#171717"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

            <Label
                Text="Turn your ideas into presentations that shine."
                FontSize="15"
                TextColor="#777777"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center"
                Margin="20,8,20,35" />

            <!-- Login Card -->
            <Border
                Padding="22"
                BackgroundColor="White"
                Stroke="#E8E8EF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout
                    Spacing="18">

                    <!-- Email -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Email"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F7F7FB"
                            Stroke="#E2E2EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">

                            <Entry
                                x:Name="EmailEntry"
                                Placeholder="Enter your email"
                                Keyboard="Email"
                                BackgroundColor="Transparent"
                                TextColor="#171717"
                                PlaceholderColor="#999999" />

                        </Border>

                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Password"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F7F7FB"
                            Stroke="#E2E2EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">

                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Enter your password"
                                IsPassword="True"
                                BackgroundColor="Transparent"
                                TextColor="#171717"
                                PlaceholderColor="#999999" />

                        </Border>

                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button
                        Text="Log In"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="#6C3BDE"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,5,0,0"
                        Clicked="OnLoginClicked" />

                    <!-- Create Account -->
                    <Button
                        Text="Create an Account"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#6C3BDE"
                        Clicked="OnCreateAccountClicked" />

                </VerticalStackLayout>

            </Border>

            <!-- Trust / Governance -->
            <Label
                Text="Your ideas stay under your control."
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#555555"
                HorizontalTextAlignment="Center"
                Margin="10,28,10,4" />

            <Label
                Text="AI-generated suggestions are designed to support your creativity, not replace your voice."
                FontSize="12"
                TextColor="#888888"
                HorizontalTextAlignment="Center"
                Margin="15,0,15,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>