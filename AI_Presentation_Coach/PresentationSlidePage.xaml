<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AI_Presentation_Coach.PresentationSlidePage"
    Title="Presentation">

    <Grid
        RowDefinitions="Auto,*"
        BackgroundColor="#F7F7FB">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="2">

                <Label
                    Text="Presentation"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#171717" />

                <Label
                    Text="Review your generated slides"
                    FontSize="13"
                    TextColor="#777777" />

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="Present"
                BackgroundColor="#6C3BDE"
                TextColor="White"
                CornerRadius="10"
                Padding="18,8" />

        </Grid>

        <!-- Main Content -->
        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="20">

                <Label
                    Text="Your Presentation Slides"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#171717" />

                <VerticalStackLayout
                    x:Name="SlidesContainer"
                    Spacing="18" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>