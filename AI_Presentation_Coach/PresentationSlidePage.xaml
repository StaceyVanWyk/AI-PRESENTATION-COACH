<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AI_Presentation_Coach.PresentationSlidePage"
    Title="Presentation Slides">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Your Presentation Slides"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Review your generated slides before presenting."
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <VerticalStackLayout
                x:Name="SlidesContainer"
                Spacing="15"
                />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
